rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /reflections/{reflectionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        allow read, update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }

      match /notes/{noteId} {
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        allow read, update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // Scenario overrides (name/summary/intensity edits) are publicly readable
    match /scenarioOverrides/{scenarioId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin codes are server-only — no client reads or writes ever
    match /adminCodes/{codeId} {
      allow read, write: if false;
    }

    // Storylines are publicly readable; writes only via Cloud Functions
    match /storylines/{storylineId} {
      allow read: if true;
      allow write: if false;
    }

    // Custom categories are publicly readable; writes only via Cloud Functions
    match /customCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // Transcripts: users can create and read their own; writes via client only
    match /transcripts/{transcriptId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
